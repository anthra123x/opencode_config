#!/usr/bin/env bash
set -euo pipefail

# ecc — OpenCode Swarm Configuration Manager CLI
# Installed to ~/.local/bin/ecc by install.sh

ECC_CONFIG="${ECC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
ECC_SKILLS="${ECC_SKILLS:-$HOME/.opencode/skills}"
ECC_ROOT="${ECC_ROOT:-$HOME/.local/share/opencode}"

# Source installed libraries
if [ -f "$ECC_CONFIG/lib/ui.sh" ]; then
  source "$ECC_CONFIG/lib/ui.sh"
  setup_ui
fi
if [ -f "$ECC_CONFIG/lib/paths.sh" ]; then
  source "$ECC_CONFIG/lib/paths.sh"
  setup_paths
fi
if [ -f "$ECC_CONFIG/lib/utils.sh" ]; then
  source "$ECC_CONFIG/lib/utils.sh"
  setup_utils
fi

# Fallback UI colors if not sourced
C_CYAN="${C_CYAN:-\033[36m}"
C_GREEN="${C_GREEN:-\033[32m}"
C_YELLOW="${C_YELLOW:-\033[33m}"
C_RED="${C_RED:-\033[31m}"
C_MAGENTA="${C_MAGENTA:-\033[35m}"
C_BLUE="${C_BLUE:-\033[34m}"
C_BOLD="${C_BOLD:-\033[1m}"
C_DIM="${C_DIM:-\033[2m}"
C_NC="${C_NC:-\033[0m}"

log()   { echo -e "${C_GREEN}✓${C_NC} $1"; }
info()  { echo -e "${C_CYAN}→${C_NC} $1"; }
warn()  { echo -e "${C_YELLOW}⚠${C_NC} $1"; }
issue() { echo -e "${C_RED}✗${C_NC} $1"; }

in_path() {
  local dir="${1:-$HOME/.local/bin}"
  case ":$PATH:" in
    *:"$dir":*) return 0 ;;
    *) return 1 ;;
  esac
}

show_help() {
  cat <<EOF
Usage: ecc <command> [options]

Commands:
  doctor      Run comprehensive diagnostic checks on the Swarm installation
  status      Show installation overview, agents roster, and MCP status
  live        Real-time multi-window swarm monitor (use --watch for auto-refresh)
  web         Launch Swarm Cockpit & GetBrain Web Dashboard (use --open to view)
  team        Display real-time multi-agent team board and active tasks
  memory      Query persistent context memory (e.g. 'ecc memory auth' or 'ecc memory')
  validate    Verify integrity of JSON, JSONC, agent definitions, and skills
  configure   Re-run the interactive configuration wizard
  update      Pull latest version from git repository and re-apply
  uninstall   Remove all installed files (with automatic backup)
  help        Show this help message

Examples:
  ecc doctor
  ecc live --watch
  ecc web --open
  ecc team
  ecc memory "database conventions"
  ecc validate

Report issues: https://github.com/anthra123x/opencode_config
EOF
}

# ─── Doctor ───

cmd_doctor() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc doctor — Swarm System Diagnostic${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  local issues=0

  # opencode CLI
  if command -v opencode &>/dev/null; then
    log "OpenCode CLI: $(command -v opencode) ($(opencode --version 2>/dev/null || echo 'active'))"
  elif command -v claude &>/dev/null; then
    log "Claude Code CLI: $(command -v claude)"
  else
    issue "No opencode or claude CLI found in PATH"
    issues=$((issues + 1))
  fi

  # Python 3 & SQLite FTS5
  if command -v python3 &>/dev/null; then
    if python3 -c "import sqlite3; conn = sqlite3.connect(':memory:'); conn.execute('CREATE VIRTUAL TABLE t USING fts5(c)')" &>/dev/null; then
      log "Python 3 with SQLite FTS5: $(python3 --version 2>&1)"
    else
      warn "Python 3 found but SQLite FTS5 extension missing (context-memory may use LIKE fallback)"
    fi
  else
    issue "Python 3 not found in PATH (required for native MCP servers)"
    issues=$((issues + 1))
  fi

  # Config directory & core files
  if [ -d "$ECC_CONFIG" ]; then
    log "Config directory: $ECC_CONFIG"
    for f in opencode.jsonc opencode.json tui.json INSTRUCTIONS.md AGENTS.md; do
      if [ -f "$ECC_CONFIG/$f" ]; then
        log "  ✓ $f"
      else
        warn "  ✗ $f (missing)"
        issues=$((issues + 1))
      fi
    done
  else
    issue "Config directory not found: $ECC_CONFIG"
    issues=$((issues + 1))
  fi

  # Specialized Sub-Agents
  if [ -d "$ECC_CONFIG/agents" ]; then
    local acount; acount=$(find "$ECC_CONFIG/agents" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l)
    log "Specialized Agents: $acount agent(s) installed"
    for a in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$a" ] || continue
      log "  ✓ @$(basename "$a" .md)"
    done
  else
    warn "Agents directory not found: $ECC_CONFIG/agents"
    issues=$((issues + 1))
  fi

  # Native MCP Servers
  if [ -f "$ECC_CONFIG/mcp/context-memory/server.py" ]; then
    log "MCP Server [context-memory]: $ECC_CONFIG/mcp/context-memory/server.py"
  else
    warn "MCP Server [context-memory] missing"
    issues=$((issues + 1))
  fi

  if [ -f "$ECC_CONFIG/mcp/team-collab/server.py" ]; then
    log "MCP Server [team-collab]: $ECC_CONFIG/mcp/team-collab/server.py"
  else
    warn "MCP Server [team-collab] missing"
    issues=$((issues + 1))
  fi

  # Skills
  if [ -d "$ECC_SKILLS" ]; then
    local scount; scount=$(find "$ECC_SKILLS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    log "Skills directory: $ECC_SKILLS ($scount skills)"
  else
    warn "Skills directory not found: $ECC_SKILLS"
    issues=$((issues + 1))
  fi

  # PATH check
  local bindir="${HOME}/.local/bin"
  if in_path "$bindir"; then
    log "\$PATH includes $bindir"
  else
    warn "\$PATH does not include $bindir — add it to your ~/.bashrc or ~/.zshrc"
    issues=$((issues + 1))
  fi

  # bash version
  if [[ ${BASH_VERSINFO[0]} -ge 4 ]]; then
    log "bash: ${BASH_VERSION}"
  else
    warn "bash 4+ required (found ${BASH_VERSINFO[0]})"
    issues=$((issues + 1))
  fi

  echo ""
  if [ "$issues" -eq 0 ]; then
    echo -e "${C_GREEN}${C_BOLD}✓ All Swarm checks passed successfully!${C_NC}"
  else
    echo -e "${C_YELLOW}${C_BOLD}⚠ $issues issue(s) detected${C_NC}"
    echo "  Run 'ecc validate' for file-level integrity checks"
  fi
}

# ─── Status ───

cmd_status() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc status — Swarm Installation Overview${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""

  # Configuration
  echo -e "  ${C_BOLD}Configuration:${C_NC}"
  if [ -d "$ECC_CONFIG" ]; then
    local csize; csize=$(du -sh "$ECC_CONFIG" 2>/dev/null | cut -f1)
    echo "    Path:   $ECC_CONFIG"
    echo "    Size:   ${csize:-unknown}"
    local theme_name="default"
    if [ -f "$ECC_CONFIG/tui.json" ]; then
      theme_name=$(python3 -c "import json; print(json.load(open('$ECC_CONFIG/tui.json')).get('theme', 'default'))" 2>/dev/null || echo "tokyonight")
    fi
    echo -e "    Theme:  ${C_MAGENTA}$theme_name${C_NC}"
  else
    warn "    Not installed"
  fi

  # Agents Roster
  echo ""
  echo -e "  ${C_BOLD}Specialized Agents Roster:${C_NC}"
  if [ -d "$ECC_CONFIG/agents" ]; then
    for f in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$f" ] || continue
      local aname; aname=$(basename "$f" .md)
      local desc; desc=$(grep -m 1 "^description:" "$f" 2>/dev/null | sed 's/^description: *//' || echo "")
      if [ "$aname" = "orchestrator" ]; then
        echo -e "    ${C_MAGENTA}• @$aname${C_NC} (primary): $desc"
      elif [ "$aname" = "backend" ]; then
        echo -e "    ${C_BLUE}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "frontend" ]; then
        echo -e "    ${C_RED}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "git-flow" ]; then
        echo -e "    ${C_GREEN}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "qa-auditor" ]; then
        echo -e "    ${C_YELLOW}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "devops" ]; then
        echo -e "    ${C_CYAN}• @$aname${C_NC} (subagent): $desc"
      else
        echo -e "    • @$aname (subagent): $desc"
      fi
    done
  else
    warn "    No agents installed"
  fi

  # MCP Servers & Storage
  echo ""
  echo -e "  ${C_BOLD}Native MCP Servers & Storage:${C_NC}"
  local mem_db="${OPENCODE_MEMORY_DB:-$HOME/.opencode/memory/context_memory.db}"
  local team_db="${OPENCODE_TEAM_DB:-$HOME/.opencode/team/team_collab.db}"

  if [ -f "$mem_db" ]; then
    local mcount; mcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$mem_db'); print(conn.execute('SELECT COUNT(*) FROM memories').fetchone()[0])" 2>/dev/null || echo "0")
    local msize; msize=$(du -sh "$mem_db" 2>/dev/null | cut -f1)
    echo -e "    ${C_GREEN}✓${C_NC} context-memory (FTS5): $mcount memory item(s) stored ($msize)"
  else
    echo -e "    ${C_GREEN}✓${C_NC} context-memory (ready, database will initialize on first use)"
  fi

  if [ -f "$team_db" ]; then
    local tcount; tcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$team_db'); print(conn.execute('SELECT COUNT(*) FROM team_tasks').fetchone()[0])" 2>/dev/null || echo "0")
    echo -e "    ${C_GREEN}✓${C_NC} team-collab (Swarm Bus): $tcount task(s) on board"
  else
    echo -e "    ${C_GREEN}✓${C_NC} team-collab (ready, database will initialize on first use)"
  fi

  # Skills
  echo ""
  echo -e "  ${C_BOLD}Skills Library:${C_NC}"
  if [ -d "$ECC_SKILLS" ]; then
    local scount; scount=$(find "$ECC_SKILLS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    echo "    Installed: $scount skills in $ECC_SKILLS"
  else
    warn "    Not installed"
  fi
}

# ─── Team Board ───

cmd_team() {
  local server_script="$ECC_CONFIG/mcp/team-collab/server.py"
  if [ ! -f "$server_script" ]; then
    # Fallback to repo dir
    local repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    server_script="$repo_dir/mcp/team-collab/server.py"
  fi

  if [ -f "$server_script" ]; then
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_status({}))
"
  else
    issue "team-collab server script not found"
    exit 1
  fi
}

# ─── Live Swarm Activity Monitor ───

cmd_live() {
  local server_script="$ECC_CONFIG/mcp/team-collab/server.py"
  if [ ! -f "$server_script" ]; then
    local repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    server_script="$repo_dir/mcp/team-collab/server.py"
  fi

  if [ ! -f "$server_script" ]; then
    issue "team-collab server script not found"
    exit 1
  fi

  local watch_mode=false
  for arg in "$@"; do
    if [ "$arg" = "--watch" ] || [ "$arg" = "-w" ]; then
      watch_mode=true
    fi
  done

  if [ "$watch_mode" = true ]; then
    echo -e "${C_CYAN}Starting real-time Swarm monitor (press Ctrl+C to exit)...${C_NC}"
    trap "echo -e '\n${C_NC}Monitor stopped.'; exit 0" INT
    while true; do
      clear
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_live_activity({}))
"
      sleep 2
    done
  else
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_live_activity({}))
"
  fi
}

# ─── Swarm Web Cockpit & GetBrain Server ───

cmd_web() {
  local server_script="$ECC_CONFIG/web/server.py"
  if [ ! -f "$server_script" ]; then
    local repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    server_script="$repo_dir/web/server.py"
  fi

  if [ ! -f "$server_script" ]; then
    issue "Swarm web server script not found"
    exit 1
  fi

  python3 "$server_script" "$@"
}

# ─── Memory Inspector ───

cmd_memory() {
  local server_script="$ECC_CONFIG/mcp/context-memory/server.py"
  if [ ! -f "$server_script" ]; then
    local repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    server_script="$repo_dir/mcp/context-memory/server.py"
  fi

  if [ ! -f "$server_script" ]; then
    issue "context-memory server script not found"
    exit 1
  fi

  local query="${1:-}"
  if [ -n "$query" ]; then
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_recall({'query': '''$query'''}))
"
  else
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_get_active_context({'project': 'global'}))
"
  fi
}

# ─── Validate ───

cmd_validate() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc validate — Integrity Verification${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  local errors=0

  # Check required config files
  local -a required=(
    "$ECC_CONFIG/opencode.jsonc"
    "$ECC_CONFIG/opencode.json"
    "$ECC_CONFIG/tui.json"
    "$ECC_CONFIG/INSTRUCTIONS.md"
    "$ECC_CONFIG/AGENTS.md"
  )

  for f in "${required[@]}"; do
    if [ -f "$f" ]; then
      log "  ✓ $(basename "$f")"
    else
      issue "  ✗ $f (missing)"
      errors=$((errors + 1))
    fi
  done

  # Validate JSON files
  for jf in "$ECC_CONFIG/opencode.json" "$ECC_CONFIG/tui.json"; do
    if [ -f "$jf" ]; then
      if python3 -c "import json; json.load(open('$jf'))" 2>/dev/null; then
        log "  ✓ $(basename "$jf") (valid JSON)"
      else
        issue "  ✗ $(basename "$jf") (invalid JSON syntax)"
        errors=$((errors + 1))
      fi
    fi
  done

  # Validate JSONC
  if [ -f "$ECC_CONFIG/opencode.jsonc" ]; then
    local py_script
    py_script=$(mktemp)
    cat >"$py_script" <<'PYEOF'
import json, sys
def strip_jsonc(content):
    res, i, in_str, esc = [], 0, False, False
    while i < len(content):
        c = content[i]
        if c == '"' and not esc:
            in_str = not in_str
            res.append(c)
        elif c == '\\' and not esc and in_str:
            esc = True
            res.append(c)
        elif c == '/' and i + 1 < len(content) and content[i+1] == '/' and not in_str:
            while i < len(content) and content[i] != '\n':
                i += 1
            continue
        elif c == '/' and i + 1 < len(content) and content[i+1] == '*' and not in_str:
            i += 2
            while i + 1 < len(content):
                if content[i] == '*' and content[i+1] == '/':
                    i += 2
                    break
                i += 1
            continue
        else:
            res.append(c)
            if esc: esc = False
        i += 1
    return ''.join(res)
with open(sys.argv[1]) as f:
    json.loads(strip_jsonc(f.read()))
PYEOF
    if python3 "$py_script" "$ECC_CONFIG/opencode.jsonc" 2>/dev/null; then
      log "  ✓ opencode.jsonc (valid JSONC)"
    else
      issue "  ✗ opencode.jsonc (invalid syntax)"
      errors=$((errors + 1))
    fi
    rm -f "$py_script"
  fi

  # Validate Agents
  if [ -d "$ECC_CONFIG/agents" ]; then
    for af in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$af" ] || continue
      if grep -q "^description:" "$af" && grep -q "^mode:" "$af"; then
        log "  ✓ agent: $(basename "$af" .md) (valid frontmatter)"
      else
        warn "  ✗ agent: $(basename "$af" .md) (missing frontmatter fields)"
        errors=$((errors + 1))
      fi
    done
  fi

  # Validate MCP server syntax
  for ms in "$ECC_CONFIG/mcp/context-memory/server.py" "$ECC_CONFIG/mcp/team-collab/server.py"; do
    if [ -f "$ms" ]; then
      if python3 -m py_compile "$ms" 2>/dev/null; then
        log "  ✓ $(basename "$(dirname "$ms")")/server.py (compiled cleanly)"
      else
        issue "  ✗ $(basename "$(dirname "$ms")")/server.py (python syntax error)"
        errors=$((errors + 1))
      fi
    fi
  done

  echo ""
  if [ "$errors" -eq 0 ]; then
    echo -e "${C_GREEN}${C_BOLD}✓ All Swarm files validated successfully!${C_NC}"
  else
    echo -e "${C_RED}${C_BOLD}✗ $errors error(s) found${C_NC}"
  fi
}

# ─── Configure ───

cmd_configure() {
  if [ -f "$ECC_CONFIG/scripts/configure.sh" ]; then
    exec "$ECC_CONFIG/scripts/configure.sh" "$@"
  else
    issue "Configuration script not found in $ECC_CONFIG/scripts/"
    exit 1
  fi
}

# ─── Update ───

cmd_update() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc update — Pull Latest Swarm Version${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""

  local repo_dir
  if [ -d "$ECC_ROOT/repo" ]; then
    repo_dir="$ECC_ROOT/repo"
  elif git rev-parse --show-toplevel 2>/dev/null; then
    repo_dir=$(git rev-parse --show-toplevel 2>/dev/null || true)
  fi

  if [ -n "${repo_dir:-}" ] && [ -d "${repo_dir:-}/.git" ]; then
    echo "  Repository: $repo_dir"
    (cd "$repo_dir" && git pull) && log "Repository updated" || {
      issue "Failed to pull latest changes"
      exit 1
    }
    echo ""
    info "Re-applying Swarm configuration..."
    (cd "$repo_dir" && exec ./install.sh)
  else
    warn "Repository not found locally"
    echo ""
    echo "  To update manually:"
    echo "    git clone https://github.com/anthra123x/opencode_config.git"
    echo "    cd opencode_config && ./install.sh"
  fi
}

# ─── Uninstall ───

cmd_uninstall() {
  echo -e "${C_RED}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_RED}${C_BOLD}  ecc uninstall — Remove Swarm Configuration${C_NC}"
  echo -e "${C_RED}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  echo -e "${C_RED}This will remove:${C_NC}"
  echo "    $ECC_CONFIG"
  echo "    $ECC_SKILLS"
  echo "    $HOME/.local/bin/ecc"
  echo "    $HOME/.local/bin/opencode-context-memory"
  echo "    $HOME/.local/bin/opencode-team-collab"
  echo ""

  local answer
  read -rp "Are you sure? Type 'yes' to confirm: " answer
  if [ "$answer" != "yes" ]; then
    echo "Cancelled."
    exit 0
  fi

  if [ -d "$ECC_CONFIG" ]; then
    local bk; bk=$(backup_dir "$ECC_CONFIG")
    info "Config backed up: $bk"
  fi

  rm -rf "$ECC_CONFIG" && log "Removed config: $ECC_CONFIG" || warn "Failed to remove config"
  rm -rf "$ECC_SKILLS" && log "Removed skills: $ECC_SKILLS" || warn "Failed to remove skills"
  rm -f "$HOME/.local/bin/ecc" "$HOME/.local/bin/opencode-context-memory" "$HOME/.local/bin/opencode-team-collab" 2>/dev/null || true

  echo ""
  log "Uninstall complete. Backups saved alongside original locations."
}

# ─── Main dispatch ───

main() {
  case "${1:-help}" in
    doctor|check)
      cmd_doctor
      ;;
    status|info)
      cmd_status
      ;;
    live|watch|activity)
      cmd_live "${@:2}"
      ;;
    web|cockpit|dashboard|brain|ui)
      cmd_web "${@:2}"
      ;;
    team|board|tasks)
      cmd_team
      ;;
    memory|recall|ctx)
      cmd_memory "${@:2}"
      ;;
    validate|verify)
      cmd_validate
      ;;
    configure|config|setup)
      cmd_configure "${@:2}"
      ;;
    update|upgrade)
      cmd_update
      ;;
    uninstall|remove)
      cmd_uninstall
      ;;
    help|--help|-h|"")
      show_help
      ;;
    *)
      echo "ecc: unknown command '$1'"
      echo "Run 'ecc help' for usage"
      exit 1
      ;;
  esac
}

main "$@"
