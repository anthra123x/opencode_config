{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "INSTRUCTIONS.md",
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.opencode/skills"
    ]
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "color": "#8B5CF6",
      "description": "Team Lead & Orchestrator. Monitoreo en vivo: http://localhost:4040 | GetBrain: http://localhost:4040/#brain"
    },
    "backend": {
      "mode": "primary",
      "color": "#3B82F6",
      "description": "Specialized Backend Engineer. Builds APIs, database models (PostgreSQL, Prisma, MySQL), business logic, and TDD unit tests."
    },
    "frontend": {
      "mode": "primary",
      "color": "#EC4899",
      "description": "Specialized Frontend & UI/UX Engineer. Builds responsive web interfaces with curated typography, micro-animations, and anti-slop design."
    },
    "git-flow": {
      "mode": "primary",
      "color": "#10B981",
      "description": "Specialized Git and GitHub Workflow Manager. Manages branch lifecycles, conventional semantic commits, and PR reviews."
    },
    "qa-auditor": {
      "mode": "primary",
      "color": "#F59E0B",
      "description": "Specialized Quality Assurance & Test Auditor. Audits test suites, ensures coverage >=80%, verifies builds, and detects AI regressions."
    },
    "devops": {
      "mode": "subagent",
      "color": "#06B6D4",
      "description": "Specialized DevOps and Infrastructure Engineer. Crafts lean multi-stage Dockerfiles, Docker Compose setups, and CI/CD pipelines."
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 30
  }
}
