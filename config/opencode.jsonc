{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "INSTRUCTIONS.md",
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.opencode/skills"
    ]
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "color": "#8B5CF6",
      "description": "⚡ [Swarm Lead] Orchestrator & Architect. Monitoreo: http://localhost:4040 | GetBrain: http://localhost:4040/#brain | Live Tester: http://localhost:4040/#tester"
    },
    "backend": {
      "mode": "all",
      "color": "#3B82F6",
      "description": "🛡️ [Swarm Backend] APIs, DB Models (Postgres/Prisma/MySQL) & TDD Unit Testing (>=80%)."
    },
    "frontend": {
      "mode": "all",
      "color": "#EC4899",
      "description": "🎨 [Swarm Frontend] Modern UI/UX, Spring Animations, Tokens & Anti-Slop Design."
    },
    "git-flow": {
      "mode": "all",
      "color": "#10B981",
      "description": "🌿 [Swarm GitFlow] Branch Lifecycles, Conventional Commits 1.0 & Clean Releases."
    },
    "qa-auditor": {
      "mode": "all",
      "color": "#F59E0B",
      "description": "🧪 [Swarm QA Auditor] 6-Stage Verification Loop, Live Tester & Sentinel Rule Audits."
    },
    "devops": {
      "mode": "all",
      "color": "#06B6D4",
      "description": "🐳 [Swarm DevOps] Multi-Stage Dockerfiles, Rootless Containers & CI/CD Pipelines."
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": false,
    "tail_turns": 80
  }
}
